# Verdict Backend Environment Variables
# Copy this file to backend/.env and replace placeholders with your actual keys.

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tavily Search API Key (get from https://tavily.com)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Optional: Groq Model override (defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
